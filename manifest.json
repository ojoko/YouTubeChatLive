{
  "manifest_version": 3,
  "name": "YouTubeChatLive - 弾幕コメント表示",
  "version": "1.2.0",
  "description": "YouTubeのライブ配信・動画上でチャットコメントを画面上に流す/固定表示するChrome拡張機能です。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTubeChatLive 設定"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/live/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/live_chat_replay*"
      ],
      "js": [
        "chat_observer.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
